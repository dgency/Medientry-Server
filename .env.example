NODE_ENV="production"
HOST="0.0.0.0"
PORT="5000"

# Local development example:
# PUBLIC_BASE_URL="http://localhost:5000"
# CLIENT_URL="http://localhost:3000"
# ADMIN_URL="http://localhost:5173"
# CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://YOUR_COMPUTER_LOCAL_IP:3000,http://localhost:5173,http://127.0.0.1:5173,http://YOUR_COMPUTER_LOCAL_IP:5173"

# Public HTTPS origin for this API, used when generating absolute upload URLs.
PUBLIC_BASE_URL="https://api.example.com"

# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_STRONG_DB_PASSWORD@db.example.internal:5432/medientry_cms"

# Long random secret, at least 32 characters.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="12h"
JWT_REMEMBER_EXPIRES_IN="14d"
AUTH_COOKIE_NAME="medientry_access_token"

# Public frontend and admin dashboard origins. Use HTTPS in production.
CLIENT_URL="https://www.example.com"
ADMIN_URL="https://admin.example.com"
# Optional absolute public website URL used in emails for logo/source links when
# local development values would not be reachable from inboxes.
EMAIL_PUBLIC_SITE_URL="https://www.example.com"
# Optional official MediEntry WhatsApp contact used in customer confirmation emails.
WHATSAPP_NUMBER="8801713456910"
WHATSAPP_DISPLAY_NUMBER="+880 1713-456910"

# Optional extra allowed origins, comma-separated, only if needed.
CORS_ORIGINS="https://www.example.com,https://admin.example.com"

# Keep MAIL_ENABLED=false until the SMTP values below are real production values
# and the connection has been verified successfully in the target environment.
MAIL_ENABLED="false"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_REQUIRE_TLS="true"
MAIL_USER="medientry@gmail.com"
MAIL_PASS="ADD_THE_NEW_GMAIL_APP_PASSWORD_LOCALLY"
MAIL_FROM_NAME="Medientry"
MAIL_FROM_EMAIL="medientry@gmail.com"
MAIL_REPLY_TO_EMAIL="medientry@gmail.com"
ADMIN_NOTIFICATION_EMAILS="medientry@gmail.com,info@medientrybd.com,anik.dgency@gmail.com"
MAIL_CONNECTION_TIMEOUT_MS="10000"
MAIL_GREETING_TIMEOUT_MS="10000"
MAIL_SOCKET_TIMEOUT_MS="20000"

BCRYPT_SALT_ROUNDS="10"

# Bootstrap super-admin account. The runtime bootstrap only creates the account
# when it is missing and never resets an existing password. The intentional seed
# command also skips password resets for existing admins.
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="anik.dgency@gmail.com"
SEED_SUPER_ADMIN_PASSWORD="SET_A_STRONG_TEMPORARY_PASSWORD_BEFORE_SEEDING"
